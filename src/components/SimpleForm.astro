---
interface Props {
  kind: "kontakt" | "kariera";
  submitLabel: string;
  messageLabel: string;
  showTrade?: boolean;
}
const { kind, submitLabel, messageLabel, showTrade = false } = Astro.props;
const trades = ["Tesař", "Pokrývač", "Klempíř", "Montážník", "Výroba v hale"];
---

<form class="form" data-kind={kind} novalidate>
  <label class="hp">Web<input name="hp" tabindex="-1" autocomplete="off" /></label>
  <label>Jméno<input name="name" autocomplete="name" /></label>
  <label>E-mail<input name="email" type="email" autocomplete="email" /></label>
  <label>Telefon<input name="phone" type="tel" autocomplete="tel" /></label>
  {
    showTrade && (
      <label>
        Řemeslo
        <select name="trade">
          <option value="">Vyberte</option>
          {trades.map((trade) => (
            <option value={trade}>{trade}</option>
          ))}
        </select>
      </label>
    )
  }
  <label>
    {messageLabel}
    <textarea name="message"></textarea>
  </label>
  <label class="check">
    <input name="gdpr" type="checkbox" />
    <span>Souhlasím se zpracováním údajů za účelem odpovědi. Více v <a href="/ochrana-udaju">zásadách ochrany osobních údajů</a>.</span>
  </label>
  <p class="form-error" data-form-error hidden></p>
  <p data-form-ok hidden></p>
  <button class="btn btn-primary" type="submit">{submitLabel}</button>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("form[data-kind]");
  forms.forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const error = form.querySelector<HTMLElement>("[data-form-error]");
      const ok = form.querySelector<HTMLElement>("[data-form-ok]");
      if (error) error.hidden = true;
      if (ok) ok.hidden = true;
      const data = new FormData(form);
      const payload = {
        kind: form.dataset.kind,
        name: String(data.get("name") ?? ""),
        email: String(data.get("email") ?? ""),
        phone: String(data.get("phone") ?? ""),
        message: String(data.get("message") ?? ""),
        trade: String(data.get("trade") ?? ""),
        gdpr: data.get("gdpr") === "on",
        hp: String(data.get("hp") ?? ""),
      };
      const response = await fetch("/api/kontakt", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const body = (await response.json()) as { ok?: boolean; message?: string; errors?: string[] };
      if (!response.ok || !body.ok) {
        if (error) {
          error.hidden = false;
          error.textContent = body.errors?.join(" ") || "Zprávu se nepodařilo odeslat.";
        }
        return;
      }
      if (ok) {
        ok.hidden = false;
        ok.textContent = body.message || "Děkujeme.";
      }
      form.reset();
    });
  });
</script>
