---
import Foto from "./Foto.astro";
import { chybiObec, chybiRozmer, type Realizace } from "../data/foto";

interface Props {
  item: Realizace;
  sizes?: string;
}
const { item, sizes = "(min-width: 900px) 340px, 100vw" } = Astro.props;
---

<a class="card card-media" href={`/realizace/${item.slug}`}>
  <Foto src={item.cover.src} alt={item.cover.alt} sizes={sizes} class="card-img" />
  <div class="card-body">
    <p class="eyebrow">{item.kind}</p>
    <h3>{item.title}</h3>
    <p class="missing">Obec: {chybiObec}. Rozměr: {chybiRozmer}.</p>
    <span class="more">Otevřít realizaci</span>
  </div>
</a>
