---
import Base from "../../layouts/Base.astro";
import SplitHeading from "../../components/SplitHeading.astro";
---
<Base title="Kalkulátor dřevostavby" description="Kalkulátor dřevostavby PENTI ještě není hotový. Panely a hrubou stavbu poptáte přímo." path="/kalkulatory/drevostav">
  <article class="wrap page-hero">
    <p class="eyebrow">Kalkulačky</p>
    <SplitHeading as="h1" text="Kalkulátor dřevostavby připravujeme" />
    <p class="lead">Orientační cenu panelů tady nespočítáte. Napište nám plochu a počet podlaží, nabídku uděláme ručně. Katalog typových domů ještě nemáme.</p>
    <p><a class="btn btn-primary" href="/kontakt">Napsat nám</a></p>
  </article>
</Base>
