---
import Base from "../layouts/Base.astro";
---

<Base title="Stránka nenalezena" description="Tahle adresa na webu PENTI PREFAB není. Vraťte se na úvod, nebo spočítejte střechu." path="/404">
  <article class="wrap page-hero">
    <p class="eyebrow">404</p>
    <h1>Tuhle stránku nemáme</h1>
    <p class="lead">Odkaz je starý, nebo je v něm překlep. Úvod a poptávka střechy fungují.</p>
    <p>
      <a class="btn btn-primary" href="/">Na úvod</a>
      <a class="btn btn-secondary" href="/poptavka/strecha">Spočítat střechu</a>
    </p>
  </article>
</Base>
