---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import KartaRealizace from "../components/KartaRealizace.astro";
import { company } from "../lib/company";
import { hero, realizace, sluzby } from "../data/foto";

const description =
  "PENTI PREFAB z Ivanovic na Hané vyrábí krovy a vazníky od roku 1992 a nově dělá i pokrývačské a klempířské práce a dřevostavby. Spočítejte si střechu.";
---

<Base
  title="PENTI PREFAB | Krovy, střechy a dřevostavby"
  description={description}
  path="/"
  jsonLd={{
    "@type": "WebSite",
    name: "PENTI PREFAB",
    url: company.url,
    inLanguage: "cs-CZ",
    publisher: { "@id": "https://penti.cz/#firma" },
  }}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Ivanovice na Hané · od roku {company.since}</p>
        <h1>Krovy a střechy, které jdou spočítat</h1>
        <hr class="gold-line" />
        <p class="lead">
          Vyrábíme vazníky a klasické krovy a montujeme je. K tomu pokládáme krytinu, děláme klempířské práce a dodáváme panely dřevostaveb. Nabídku připravíme z údajů, které nám pošlete.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/poptavka/strecha">Spočítat střechu</a>
          <a class="btn btn-secondary" href="/drevostavby/typove-domy">Vybrat typový dům</a>
        </div>
      </div>
      <figure class="hero-figure">
        <Foto
          src={hero.src}
          alt={hero.alt}
          sizes="(min-width: 980px) 520px, 100vw"
          widths={[640, 960, 1280]}
          priority
          class="hero-photo"
        />
        <figcaption>Klasický krov, 2008–2023. Obec a rozměr doplníme.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="sluzby">
    <div class="wrap">
      <p class="eyebrow">Co děláme</p>
      <h2 id="sluzby">Čtyři cesty, jak u nás začít</h2>
      <div class="pillars">
        <a class="card card-media" href="/strechy/krovy">
          <Foto src={sluzby.konstrukce.src} alt={sluzby.konstrukce.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Krovy a konstrukce</h3>
            <p>Příhradové vazníky do rozpětí 30 m bez vnitřní podpory a klasické krovy včetně pohledového dřeva.</p>
            <span class="more">Vazníky a krovy</span>
          </div>
        </a>
        <a class="card card-media" href="/strechy/pokryvacstvi">
          <Foto src={sluzby.pokryvacstvi.src} alt={sluzby.pokryvacstvi.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Pokrývačství</h3>
            <p>Latění nebo bednění, pojistná hydroizolace a pokládka krytiny. Na snímku bobrovka z roku 2007.</p>
            <span class="more">Pokrývačské práce</span>
          </div>
        </a>
        <a class="card card-media" href="/strechy/klempirstvi">
          <Foto src={sluzby.klempirstvi.src} alt={sluzby.klempirstvi.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Klempířství</h3>
            <p>Okapy, svody, lemování a úžlabí. Na snímku oplechování komínů z roku 2007.</p>
            <span class="more">Klempířské práce</span>
          </div>
        </a>
        <a class="card card-media" href="/drevostavby">
          <Foto src={sluzby.drevostavby.src} alt={sluzby.drevostavby.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Typové dřevostavby</h3>
            <p>Panely a hrubou stavbu už vyrábíme. Katalog typových domů teprve schvalujeme, ceny tu proto nejsou.</p>
            <span class="more">Dřevostavby</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="postup">
    <div class="wrap">
      <p class="eyebrow">Postup</p>
      <h2 id="postup">Od podkladů po předání</h2>
      <ol class="steps">
        <li><span>01</span><h3>Poptávka</h3><p>Pošlete projekt, nebo náčrt, adresu a co má střecha umět.</p></li>
        <li><span>02</span><h3>Rozpočet</h3><p>Připravíme předběžný rozpočet a sejdeme se nad ním.</p></li>
        <li><span>03</span><h3>Zaměření</h3><p>Stavbu zaměříme a upřesníme konstrukci i termín.</p></li>
        <li><span>04</span><h3>Výroba</h3><p>Po záloze vyrobíme konstrukci v hale v Ivanovicích na Hané.</p></li>
        <li><span>05</span><h3>Montáž</h3><p>Přivezeme ji, smontujeme a v domluveném rozsahu předáme.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="reference">
    <div class="wrap">
      <p class="eyebrow">Realizace</p>
      <h2 id="reference">Vybrané zakázky</h2>
      <p>Názvy jsou podle typu práce a roku z podkladů. Obec a rozměr u každé karty teprve doplníme, nevymýšlíme je.</p>
      <div class="refs">
        {realizace.filter((item) => item.featured).map((item) => <KartaRealizace item={item} />)}
      </div>
      <p style="margin-top:16px"><a href="/realizace">Všechny realizace</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="duvera">
    <div class="wrap trust">
      <div>
        <p class="eyebrow">Proč my</p>
        <h2 id="duvera">Co o sobě můžeme říct rovnou</h2>
        <p>Výrobu máme ve vlastní hale. Konstrukci staticky posoudíme a z dat jdou prvky na CNC pilu. U vazníků používáme sušené hoblované řezivo.</p>
        <p>Působíme z Ivanovic na Hané a montáže domlouváme podle místa stavby. Orientační plochu střechy si spočítáte hned, cenu až v nabídce.</p>
      </div>
      <ul class="facts">
        <li><strong>Od roku {company.since}</strong><span>dřevěné střešní konstrukce</span></li>
        <li><strong>Do 30 m</strong><span>rozpětí vazníku bez vnitřní podpory</span></li>
        <li><strong>{company.city}</strong><span>{company.street}</span></li>
        <li><strong>{company.phoneDisplay}</strong><span><a href={`mailto:${company.inquiries}`}>{company.inquiries}</a></span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Pošlete střechu k nacenění</h2>
          <p>Sedm krátkých kroků. Rozpracované údaje zůstanou v tomto prohlížeči. Cenu slibovat nebudeme, výkaz plochy ano.</p>
        </div>
        <a class="btn btn-primary" href="/poptavka/strecha">Spočítat střechu</a>
      </div>
    </div>
  </section>
</Base>
