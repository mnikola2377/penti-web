---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import KartaRealizace from "../components/KartaRealizace.astro";
import SplitHeading from "../components/SplitHeading.astro";
import { company, eshopLinks } from "../lib/company";
import { hero, realizace, sluzby } from "../data/foto";

const description =
  "PENTI PREFAB z Ivanovic na Hané vyrábí a realizuje dřevěné konstrukce a střechy na klíč. Krovy, vazníky, pokrývačství, klempířství a dřevostavby od roku 1992.";
---

<Base
  title="PENTI PREFAB | Dřevěné konstrukce a střechy na klíč"
  description={description}
  path="/"
  jsonLd={{
    "@type": "WebSite",
    name: "PENTI PREFAB",
    url: company.url,
    inLanguage: "cs-CZ",
    publisher: { "@id": "https://penti.cz/#firma" },
  }}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Ivanovice na Hané · od roku {company.since}</p>
        <SplitHeading as="h1" text="Vyrábíme a realizujeme dřevěné konstrukce a střechy na klíč" />
        <hr class="gold-line" />
        <p class="lead">
          Vazníky, klasické krovy, krytinu, klempířské práce i panely dřevostaveb. Nabídku připravíme podle podkladů, které nám pošlete.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/poptavka/strecha">Poptat střechu</a>
          <a class="btn btn-secondary" href="/drevostavby">Dřevostavby</a>
        </div>
      </div>
      <figure class="hero-figure">
        <Foto
          src={hero.src}
          alt={hero.alt}
          sizes="(min-width: 980px) 520px, 100vw"
          widths={[640, 960, 1280]}
          priority
          class="hero-photo"
        />
        <figcaption>Klasický krov z let 2008–2023.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="sluzby">
    <div class="wrap">
      <p class="eyebrow">Co děláme</p>
      <SplitHeading as="h2" id="sluzby" text="S čím se na nás můžete obrátit" />
      <div class="pillars">
        <a class="card card-media" href="/strechy/krovy">
          <Foto src={sluzby.konstrukce.src} alt={sluzby.konstrukce.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Krovy a konstrukce</h3>
            <p>Příhradové vazníky do rozpětí 30 m bez vnitřní podpory a klasické krovy včetně pohledového dřeva.</p>
            <span class="more">Vazníky a krovy</span>
          </div>
        </a>
        <a class="card card-media" href="/strechy/pokryvacstvi">
          <Foto src={sluzby.pokryvacstvi.src} alt={sluzby.pokryvacstvi.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Pokrývačství</h3>
            <p>Latění, pojistná hydroizolace a pokládka krytiny. Na fotce je bobrovka z roku 2007.</p>
            <span class="more">Pokrývačské práce</span>
          </div>
        </a>
        <a class="card card-media" href="/strechy/klempirstvi">
          <Foto src={sluzby.klempirstvi.src} alt={sluzby.klempirstvi.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Klempířství</h3>
            <p>Okapy, svody, lemování a úžlabí. Na fotce je oplechování komínů z roku 2007.</p>
            <span class="more">Klempířské práce</span>
          </div>
        </a>
        <a class="card card-media" href="/drevostavby">
          <Foto src={sluzby.drevostavby.src} alt={sluzby.drevostavby.alt} sizes="(min-width: 980px) 260px, 100vw" class="card-img" />
          <div class="card-body">
            <h3>Typové dřevostavby</h3>
            <p>Panely a hrubou stavbu vyrábíme. Katalog typových domů ještě nemáme, ceny tu nejsou.</p>
            <span class="more">Dřevostavby</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="postup">
    <div class="wrap">
      <p class="eyebrow">Postup</p>
      <SplitHeading as="h2" id="postup" light="Jak" strong="pracujeme" />
      <p>Používáme prověřené materiály a skladby. Levné výrobky do střechy nezabudováváme, protože z dlouhodobého hlediska vyjdou nejdráž.</p>
      <p>Když chcete nabídku na střešní konstrukci, pošlete projekt a popište, co potřebujete. Když projekt není, stačí náčrt. Připravíme předběžný rozpočet, sejdeme se, stavbu zaměříme a po záloze zahájíme výrobu.</p>
      <ol class="steps">
        <li><span>01</span><h3>Projekt nebo náčrt</h3><p>Pošlete projekt a popište, co potřebujete. Když projekt není, stačí náčrt.</p></li>
        <li><span>02</span><h3>Předběžný rozpočet</h3><p>Připravíme předběžný rozpočet.</p></li>
        <li><span>03</span><h3>Schůzka a zaměření</h3><p>Sejdeme se a stavbu zaměříme.</p></li>
        <li><span>04</span><h3>Záloha a výroba</h3><p>Po záloze zahájíme výrobu.</p></li>
      </ol>
      <p style="margin-top:20px"><a class="btn btn-primary" href="/poptavka/strecha">Poptat střechu</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="reference">
    <div class="wrap">
      <p class="eyebrow">Realizace</p>
      <SplitHeading as="h2" id="reference" text="Vybrané zakázky" />
      <p>U fotek uvádíme typ práce a rok. Obec a rozměr doplníme, až je budeme znát.</p>
      <div class="refs">
        {realizace.filter((item) => item.featured).map((item) => <KartaRealizace item={item} />)}
      </div>
      <p style="margin-top:16px"><a href="/realizace">Všechny realizace</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="duvera">
    <div class="wrap trust">
      <div>
        <p class="eyebrow">Výroba</p>
        <SplitHeading as="h2" id="duvera" text="Vlastní hala v Ivanovicích na Hané" />
        <p>Konstrukci staticky spočítáme a prvky řežeme na CNC pile. Na vazníky bereme sušené hoblované řezivo.</p>
        <p>Montujeme podle místa stavby. Orientační plochu střechy si spočítáte na webu. Cenu pošleme v nabídce.</p>
      </div>
      <ul class="facts">
        <li><strong>Od roku {company.since}</strong><span>dřevěné střešní konstrukce</span></li>
        <li><strong>Do 30 m</strong><span>rozpětí vazníku bez vnitřní podpory</span></li>
        <li><strong>{company.city}</strong><span>{company.street}</span></li>
        <li><strong>{company.phoneDisplay}</strong><span><a href={`mailto:${company.inquiries}`}>{company.inquiries}</a></span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="eshop">
    <div class="wrap">
      <p class="eyebrow">Sklad</p>
      <SplitHeading as="h2" id="eshop" light="Řezivo" strong="a materiál v e-shopu" />
      <p>
        Ceny, dostupnost a objednávku necháváme v e-shopu. Tady jsou jen skupiny zboží, které tam opravdu jsou.
        Osobní odběr je v {company.city}. Otevírací dobu výdeje e-shop zatím neuvádí.
      </p>
      <div class="pillars eshop-links">
        {
          eshopLinks.map((item) => (
            <a class="card" href={item.href} rel="noopener noreferrer">
              <h3>{item.label}</h3>
              <p>{item.note}</p>
              <span class="more">Otevřít v e-shopu</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:16px"><a href={company.eshop} rel="noopener noreferrer">Celý e-shop</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="band">
        <div>
          <SplitHeading as="h2" text="Chcete nabídku na střechu?" />
          <p>Vyplníte údaje o střeše. Rozpracovanou poptávku si prohlížeč pamatuje. Hned uvidíte orientační plochu a délky, cenu až v nabídce.</p>
        </div>
        <a class="btn btn-primary" href="/poptavka/strecha">Poptat střechu</a>
      </div>
    </div>
  </section>
</Base>
