---
import Base from "../../layouts/Base.astro";
import fragment from "../../kalkulacka/strecha-body.html?raw";
import "../../styles/kalkulacka.css";

const description =
  "Kalkulátor střechy PENTI spočítá výkaz materiálu: krytinu, latě, fólii a okapy. Cenu dodá rozpočtář. Nejde o závaznou nabídku.";
---

<Base title="Kalkulátor střechy" description={description} path="/poptavka/strecha">
  <div class="kalk" set:html={fragment} />
</Base>

<script is:inline src="/js/penti/penti-engine.js"></script>
<script is:inline src="/js/penti/penti-okapy.js"></script>
<script is:inline src="/js/penti/penti-katalog-web.js"></script>
<script is:inline src="/js/penti/penti-strecha-web.js"></script>
<script is:inline src="/js/penti/penti-statika.js"></script>
<script is:inline src="/js/penti/penti-rezivo.js"></script>
<script is:inline src="/js/penti/penti-spoje.js"></script>
<script is:inline src="/js/penti/penti-narozi.js"></script>
<script is:inline src="/js/penti/penti-krov.js"></script>
<script is:inline src="/js/penti/penti-krov-profily.js"></script>
<script is:inline src="/js/penti/penti-krov-web.js"></script>
<script is:inline src="/js/penti/penti-spojovak.js"></script>
<script is:inline src="/js/penti/penti-kresba-web.js"></script>
<script is:inline src="/js/penti/kalkulacka-strecha.js"></script>
<script is:inline>
  function pdToggle(r) {
    var b = r.closest(".pd-blok");
    if (!b) return;
    var s = b.querySelector(".pd-soubory");
    if (s) s.style.display = r.value === "ano" && r.checked ? "block" : "none";
  }
</script>
