---
import Base from "../../layouts/Base.astro";
import "../../styles/configurator.css";

const shapes = [
  { id: "sedlova", label: "Sedlová", path: "M8 40 L44 12 L80 40" },
  { id: "valbova", label: "Valbová", path: "M8 40 L28 16 L60 16 L80 40" },
  { id: "pultova", label: "Pultová", path: "M8 18 L80 40" },
  { id: "mansardova", label: "Mansardová", path: "M8 42 L22 28 L44 12 L66 28 L80 42" },
  { id: "jina", label: "Jiná", path: "M10 40 L24 18 L40 30 L58 12 L80 40" },
];
---

<Base
  title="Poptávka střechy"
  description="Vedená poptávka střechy PENTI: tvar, adresa stavby, rozměry, krytina, klempíř a podklady. Výsledkem je datový balíček pro nabídku, ne ceník."
  path="/poptavka/strecha"
>
  <article class="wrap page-hero">
    <p class="eyebrow">Poptávka</p>
    <h1>Spočítat střechu</h1>
    <p class="lead">Sedm kroků. Na konci uvidíte orientační plochu a délky a stáhnete si datový balíček. Závazná cena vznikne až v nabídce.</p>
    <div id="konfigurator">
      <div class="restore" id="obnova" hidden>
        <p>Máme rozpracovanou poptávku.</p>
        <div>
          <button class="btn btn-primary" type="button" id="pokracovat-draft">Pokračovat</button>
          <button class="btn btn-secondary" type="button" id="zahodit-draft">Začít znovu</button>
        </div>
      </div>
      <div class="cfg">
        <ol class="cfg-progress" id="postup" aria-label="Postup poptávky"></ol>
        <form id="poptavka-form" novalidate>
          <input type="hidden" name="inquiry_id" />
          <input type="hidden" name="draft_id" />
          <label class="hp">Firma<input name="hp" tabindex="-1" autocomplete="off" /></label>

          <section class="cfg-panel" data-step>
            <h2>Záměr a rozsah</h2>
            <p>Můžete vybrat víc služeb najednou. Kompletní střecha zatrhne konstrukci, krytinu i klempíře.</p>
            <fieldset>
              <legend>O jakou stavbu jde?</legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="job" value="novostavba" /><span>Novostavba</span></label>
                <label class="choice"><input type="radio" name="job" value="rekonstrukce" /><span>Rekonstrukce</span></label>
              </div>
            </fieldset>
            <fieldset>
              <legend>Co poptáváte?</legend>
              <div class="choices">
                <label class="choice"><input type="checkbox" name="services" value="konstrukce" /><span>Konstrukce</span></label>
                <label class="choice"><input type="checkbox" name="services" value="pokryvacstvi" /><span>Pokrývačství</span></label>
                <label class="choice"><input type="checkbox" name="services" value="klempirstvi" /><span>Klempířství</span></label>
                <label class="choice"><input type="checkbox" name="services" value="kompletni_strecha" /><span>Kompletní střecha</span></label>
                <label class="choice"><input type="checkbox" name="services" value="material" /><span>Jen materiál</span></label>
              </div>
            </fieldset>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Místo stavby</h2>
            <p>Adresa je důležitější než prázdný formulář. Sněhovou a větrnou oblast zatím vyberte podle projektu. Automatický návrh z mapy doplníme, až bude klíč k mapové službě.</p>
            <div class="grid-2">
              <label>Ulice a číslo<input name="address" autocomplete="street-address" /></label>
              <label>Obec<input name="municipality" autocomplete="address-level2" /></label>
              <label>PSČ<input name="postal" inputmode="numeric" autocomplete="postal-code" /></label>
              <label>Parcelní číslo, když ho znáte<input name="parcel" /></label>
            </div>
            <label>Kód stavebního objektu RÚIAN, volitelně<input name="ruian" /></label>
            <div class="grid-2">
              <label>Sněhová oblast
                <select name="snow">
                  <option value="">Doplníme</option>
                  {["I", "II", "III", "IV", "V", "VI", "VII", "VIII"].map((item) => <option value={item}>{item}</option>)}
                </select>
              </label>
              <label>Větrná oblast
                <select name="wind">
                  <option value="">Doplníme</option>
                  {["I", "II", "III", "IV", "V"].map((item) => <option value={item}>{item}</option>)}
                </select>
              </label>
            </div>
            <p class="muted">Vzdálenost od výrobny v Ivanovicích na Hané dopočítáme z adresy. Teď ji do balíčku nepíšeme.</p>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Tvar a rozměry</h2>
            <fieldset>
              <legend>Tvar střechy</legend>
              <div class="choices">
                {
                  shapes.map((shape) => (
                    <label class="choice">
                      <input type="radio" name="shape" value={shape.id} />
                      <span>
                        <svg viewBox="0 0 88 56" aria-hidden="true">
                          <path d={shape.path} fill="none" stroke="#1B251E" stroke-width="3" />
                          <path d="M8 46 H80" stroke="#46704A" stroke-width="3" />
                        </svg>
                        {shape.label}
                      </span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset>
              <legend>Půdorys</legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="plan" value="obdelnik" checked /><span>Obdélník</span></label>
                <label class="choice"><input type="radio" name="plan" value="jiny" /><span>Jiný půdorys</span></label>
              </div>
            </fieldset>
            <p data-when="valba" class="muted">U valbové střechy počítáme přesah okapu na všech čtyřech stranách.</p>
            <label class="check"><input type="checkbox" name="dimensions_unknown" /><span>Rozměry neznám, přiložím výkres</span></label>
            <div class="grid-2">
              <label>Šířka, rozpětí mezi okapy (m)<input name="width" inputmode="decimal" /></label>
              <label>Délka ve směru hřebene (m)<input name="length" inputmode="decimal" /></label>
              <label>Sklon (°)<input name="pitch" inputmode="decimal" /></label>
              <label>Vikýře, počet<input name="dormers" inputmode="numeric" value="0" /></label>
              <label>Přesah okapu (m)<input name="eave" inputmode="decimal" value="0.6" /></label>
              <label>Přesah štítu (m)<input name="gable" inputmode="decimal" value="0.3" /></label>
            </div>
            <div data-when="mansarda" class="grid-2">
              <label>Horní sklon mansardy (°)<input name="pitch_upper" inputmode="decimal" /></label>
              <label>Zlom od pozednice (m)<input name="break_m" inputmode="decimal" /></label>
            </div>
            <div class="vykaz" id="vykaz" aria-live="polite"></div>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Konstrukce a podkroví</h2>
            <div data-when="konstrukce">
              <fieldset>
                <legend>Nosná konstrukce</legend>
                <div class="choices">
                  <label class="choice"><input type="radio" name="structure" value="vaznik" /><span>Vazníky</span></label>
                  <label class="choice"><input type="radio" name="structure" value="krov" /><span>Krov</span></label>
                  <label class="choice"><input type="radio" name="structure" value="hotova" /><span>Už stojí</span></label>
                </div>
              </fieldset>
            </div>
            <div data-when="rekonstrukce">
              <fieldset>
                <legend>Zůstává stávající konstrukce?</legend>
                <div class="choices">
                  <label class="choice"><input type="radio" name="keep" value="ano" /><span>Ano, zůstává</span></label>
                  <label class="choice"><input type="radio" name="keep" value="ne" /><span>Ne, mění se</span></label>
                </div>
              </fieldset>
            </div>
            <fieldset>
              <legend>Využití podkroví</legend>
              <div class="choices">
                <label class="choice"><input type="radio" name="attic" value="nevyapene" /><span>Nevytápěné</span></label>
                <label class="choice"><input type="radio" name="attic" value="puda" /><span>Půda</span></label>
                <label class="choice"><input type="radio" name="attic" value="obytne" /><span>Obytné</span></label>
              </div>
            </fieldset>
            <div data-when="drevo" class="grid-2">
              <label>Řezivo
                <select name="timber">
                  <option value="">Podle návrhu</option>
                  <option value="susene_hoblovane">Sušené hoblované</option>
                  <option value="kvh">KVH</option>
                  <option value="bsh">BSH</option>
                  <option value="dle_navrhu">Nechám na statikovi</option>
                </select>
              </label>
              <label>Rozteč vazníků nebo krokví (mm)<input name="spacing" inputmode="numeric" /></label>
              <label class="check"><input type="checkbox" name="knee" /><span>Počítat s nadezdívkou</span></label>
            </div>
            <p data-when="nzu" class="notice">
              U obytného podkroví a u rekonstrukce řešíme skladbu a zateplení. Výši dotace neslibujeme. Podmínky programu jsou na
              <a href="https://novazelenausporam.cz/">novazelenausporam.cz</a>.
            </p>
            <label>Zájem o zateplení podkroví
              <select name="insulation">
                <option value="">Nevybráno</option>
                <option value="ano">Ano</option>
                <option value="ne">Ne</option>
                <option value="nevim">Nevím</option>
              </select>
            </label>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Skladba a oplechování</h2>
            <p>Části, které nepoptáváte, přeskočíme. Značky krytin sem nepíšeme, v nabídce je doplníme podle skladby.</p>
            <div data-when="krytina" class="grid-2">
              <label>Krytina
                <select name="covering">
                  <option value="">Vyberte</option>
                  <option value="betonova_taska">Betonová taška</option>
                  <option value="palena_taska">Pálená taška</option>
                  <option value="plechova">Plechová krytina</option>
                  <option value="vlaknocement">Vláknocement</option>
                  <option value="sindel">Šindel</option>
                  <option value="foliova">Fóliová krytina</option>
                  <option value="jina">Jiná</option>
                </select>
              </label>
              <label>Povrch
                <select name="finish">
                  <option value="">Nechám na návrhu</option>
                  <option value="prirodni">Přírodní</option>
                  <option value="engoba">Engoba</option>
                  <option value="glazura">Glazura</option>
                  <option value="lak">Lak</option>
                  <option value="nezadam">Bez preference</option>
                </select>
              </label>
              <label>Barva krytiny<input name="covering_color" /></label>
              <label>Podklad krytiny
                <select name="sheathing">
                  <option value="latovani">Laťování</option>
                  <option value="plne_bedneni">Plné bednění</option>
                  <option value="nezadam">Podle návrhu</option>
                </select>
              </label>
            </div>
            <div data-when="klempir" class="grid-2">
              <label>Oplechování a okapy
                <select name="gutter">
                  <option value="">Vyberte</option>
                  <option value="pozink">Pozink</option>
                  <option value="pozink_lak">Lakovaný pozink</option>
                  <option value="hlinik">Hliník</option>
                  <option value="med">Měď</option>
                  <option value="titanzinek">Titanzinek</option>
                  <option value="jiny">Jiný</option>
                </select>
              </label>
              <label>Barva oplechování<input name="gutter_color" /></label>
            </div>
            <div class="grid-2">
              <label>Střešní okna, počet<input name="windows" inputmode="numeric" value="0" /></label>
              <label class="check"><input type="checkbox" name="snow_guards" /><span>Sněhové zachytávače</span></label>
              <label class="check"><input type="checkbox" name="safety" /><span>Bezpečnostní body na střeše</span></label>
            </div>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Podklady a termín</h2>
            <p>Fotografie a výkresy zůstanou v tomto prohlížeči, dokud poptávku neodešlete. Po obnovení stránky je nahrajte znovu.</p>
            <label>Fotografie střechy nebo stavby<input id="fotky" name="photos" type="file" accept="image/*" multiple /></label>
            <p id="seznam-fotek" class="muted">Zatím nic.</p>
            <label>Výkres, PDF nebo ZIP<input id="vykresy" name="plans" type="file" accept=".pdf,.zip,image/*" multiple /></label>
            <p id="seznam-vykresu" class="muted">Zatím nic.</p>
            <label>Kdy byste chtěli začít<input name="month" type="month" /></label>
            <label>Poznámka<textarea name="note"></textarea></label>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <section class="cfg-panel" data-step hidden>
            <h2>Náhled a kontakt</h2>
            <div class="summary" id="shrnuti"></div>
            <details>
              <summary>Datový balíček penti.inquiry.v1</summary>
              <pre class="json-view" id="json-nahled"></pre>
            </details>
            <div class="grid-2">
              <label>Jméno<input name="name" autocomplete="name" /></label>
              <label>E-mail<input name="email" type="email" autocomplete="email" /></label>
              <label>Telefon<input name="phone" type="tel" autocomplete="tel" /></label>
              <label>Jsem
                <select name="role">
                  <option value="">Vyberte</option>
                  <option value="stavebnik">Stavebník</option>
                  <option value="projektant">Projektant</option>
                  <option value="firma">Firma</option>
                </select>
              </label>
            </div>
            <label class="check">
              <input type="checkbox" name="gdpr" />
              <span>Souhlasím se zpracováním údajů pro přípravu nabídky. Více v <a href="/ochrana-udaju">zásadách</a>.</span>
            </label>
            <div class="errors" tabindex="-1" role="alert"></div>
          </section>

          <div class="cfg-nav">
            <button class="btn btn-secondary" type="button" data-back>Zpět</button>
            <button class="btn btn-secondary" type="button" id="stahnout" hidden>Stáhnout JSON</button>
            <button class="btn btn-primary" type="button" data-next>Pokračovat</button>
            <button class="btn btn-primary" type="button" id="odeslat" hidden>Odeslat poptávku</button>
          </div>
        </form>
        <section class="cfg-panel ok-box" id="vysledek" hidden>
          <h2>Poptávka je připravená</h2>
          <p></p>
          <p class="data">Číslo <span data-id></span></p>
          <button class="btn btn-secondary" type="button" data-download>Stáhnout JSON</button>
          <a class="btn btn-primary" href="/">Zpět na úvod</a>
        </section>
      </div>
    </div>
  </article>
</Base>

<script>
  import { initConfigurator } from "../../scripts/configurator";
  const root = document.querySelector<HTMLElement>("#konfigurator");
  if (root) initConfigurator(root);
</script>
